{
  "name": "placement-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port ${PLACEMENT_WEB_PORT:-5173}",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node tests/check_content.mjs ../content/articles",
    "setup:pyodide": "node scripts/setup_pyodide.mjs",
    "setup:ort": "node scripts/setup_ort.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@huggingface/transformers": "3.7.6",
    "@lezer/highlight": "1.2.5",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "pyodide": "0.27.7",
    "vite": "5.4.11"
  }
}
